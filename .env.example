# ── Configuration Générale ──────────────────────────────────────────────────
APP_NAME=DokploySentinel
APP_ENV=production
DEBUG=false
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-key

# ── Docker & Dokploy ────────────────────────────────────────────────────────
# Chemin du socket Docker (par défaut sur Linux /var/run/docker.sock)
DOCKER_SOCKET_PATH=unix://var/run/docker.sock

# Filtrer les conteneurs à surveiller (laisser vide pour surveiller TOUS les conteneurs Dokploy)
# Exemples : bestlens,miyonu,autoe-cole
MONITORED_CONTAINER_PATTERNS=

# Conteneurs à ignorer (ex: bases de données internes, redis, etc.)
IGNORED_CONTAINER_PATTERNS=pgbouncer,postgres,redis,dokploy-traefik

# ── Périodicité du Digest & Seuils d'Alerte ─────────────────────────────────
# Intervalle en heures pour l'envoi du rapport consolidé (ex: 2 ou 3)
DIGEST_INTERVAL_HOURS=3

# Seuil de latence critique en millisecondes pour déclencher une alerte
LATENCY_ALERT_THRESHOLD_MS=2000

# Seuil de taux d'erreur 5xx (en pourcentage) pour alerte
ERROR_5XX_RATE_THRESHOLD_PERCENT=5.0

# Seuil d'alerte préventive de saturation mémoire RAM (en pourcentage)
MEMORY_ALERT_THRESHOLD_PERCENT=90.0

# Seuil d'alerte préventive de saturation CPU (en pourcentage)
CPU_ALERT_THRESHOLD_PERCENT=95.0

# Cooldown anti-spam (en secondes) pour éviter les rafales d'alertes identiques
ALERT_COOLDOWN_SECONDS=300

# ── Notifications Telegram ───────────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890

# ── Notifications Discord ────────────────────────────────────────────────────
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Notifications WhatsApp (via Evolution API ou Webhook standard) ───────────
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://api.evolution.mondomaine.com
WHATSAPP_API_KEY=votre-cle-api
WHATSAPP_INSTANCE=dokploy-sentinel
WHATSAPP_RECIPIENT_NUMBER=22900000000

# ── Notifications Email (SMTP) ───────────────────────────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-app
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=alerts@mondomaine.com
EMAIL_TO=admin@mondomaine.com
