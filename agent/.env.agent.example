# ── Configuration du Sentinel-Agent pour VPS Distant ─────────────────────────
# URL de votre Hub Central DokploySentinel (déjà en ligne)
SENTINEL_HUB_URL=https://sentinel.lekyn.com

# Clé secrète (doit correspondre à la SECRET_KEY de votre Hub)
SENTINEL_API_KEY=dokploy-sentinel-secret-2026-secure-key

# Nom distinctif du serveur VPS client (ex: VPS-Client-AutoEcole, VPS-Client-Bestlens, etc.)
SERVER_NAME=VPS-Client-Nom

# Intervalle de synchronisation en secondes
SYNC_INTERVAL_SECONDS=20

# Conteneurs à ignorer
IGNORED_CONTAINER_PATTERNS=pgbouncer,postgres,redis,dokploy-traefik,dokploy-sentinel,sentinel-agent
